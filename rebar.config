{erl_opts, [debug_info]}.

{deps, [
    {erlport, {git, "https://github.com/jhw/erlport.git", {tag, "v0.1.3-go"}}},
    {thoas, "1.2.1"}
]}.

{plugins, []}.

{pre_hooks, [
    {"(linux|darwin|solaris|freebsd|netbsd|openbsd)",
     compile,
     "./scripts/build_go.sh"}
]}.

{shell, [
    {apps, [erlcracker]}
]}.

{dialyzer, [
    {warnings, [
        error_handling,
        race_conditions,
        unmatched_returns
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{ct_opts, [
    {sys_config, "config/sys.config"}
]}.
